{
  "expo": {
    "name": "حساب فارسی",
    "slug": "hesab-farsi",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "hesabfarsi",
    "plugins": [
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alisina.hesabfarsi",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.alisina.hesabfarsi",
      "versionCode": 1
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
