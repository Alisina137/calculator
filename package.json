{
  "name": "hesab-farsi",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/calculation.test.ts tests/localization.test.ts tests/dates.test.ts tests/converters.test.ts tests/tools.test.ts",
    "verify": "npm run typecheck && npm test",
    "doctor": "npx expo-doctor",
    "verify:release": "npm run compat && npm run verify && npm run doctor && npm run assets:generate",
    "assets:generate": "node scripts/generate-release-assets.mjs",
    "postinstall": "npm run assets:generate",
    "release:check": "npm run verify:release && npm run assets:generate",
    "compat": "npx expo install --check"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-screen-orientation": "~57.0.2",
    "expo-symbols": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-font": "~57.0.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.10.0",
    "sharp": "^0.34.4"
  },
  "overrides": {
    "http-errors@2.0.1": {
      "statuses": "2.0.2"
    },
    "send@0.19.2": {
      "statuses": "2.0.2"
    }
  }
}
